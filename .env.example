# Copy to .env for local use. Never commit .env. Real secrets live in ~/.secrets/triagedesk-api.env.
# Postgres connection string, e.g. postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
# Supabase user id (JWT sub) of the first admin; make seed upserts that profile with role=admin.
BOOTSTRAP_ADMIN_SUB=
# Local Supabase stack used as the token issuer (see docs/local-supabase.md).
SUPABASE_URL=http://127.0.0.1:54321
# Expected `aud` claim; confirm it from a real token issued by the local stack.
SUPABASE_JWT_AUDIENCE=authenticated
# Only when the API runs in a container and the Supabase stack on the host: where to fetch the keys
# (the `iss` claim is still checked against SUPABASE_URL). Plain http to a non-loopback host also needs the allow flag.
SUPABASE_JWKS_BASE_URL=
SUPABASE_JWKS_ALLOW_PLAIN_HTTP=false
JWKS_TIMEOUT_SECONDS=3
JWKS_CACHE_SECONDS=300
JWKS_MIN_REFETCH_SECONDS=30
# Seconds to wait for the AI model before falling back to keyword rules.
AI_TIMEOUT_SECONDS=15
# Gemini adapter. Leave the key empty to use the keyword fallback only. The real key lives in ~/.secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Largest answer the model may produce; a cut-off answer is treated as a failure (keyword fallback).
AI_MAX_OUTPUT_TOKENS=1024
# Global cap on Gemini calls per minute; over it, new tickets take the keyword fallback.
AI_CALLS_PER_MINUTE=60
# Recovery sweeper for tickets stuck in ai_status = pending (docs/adr/0006). Set ENABLED=false to turn it off.
AI_RECOVERY_ENABLED=true
AI_RECOVERY_INTERVAL_SECONDS=60
AI_RECOVERY_AGE_SECONDS=120
AI_RECOVERY_BATCH_SIZE=10
AI_RECOVERY_MAX_ATTEMPTS=3
# Rate limits per minute (in process, per app instance). Public routes and the API are per client IP; creates are per user.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_TICKET_CREATE_PER_MINUTE=10
RATE_LIMIT_COMMENT_PER_MINUTE=30
# Largest accepted request body in bytes (413 above it).
MAX_REQUEST_BODY_BYTES=65536
# Serve the interactive docs and the OpenAPI document (/docs, /redoc, /openapi.json). Off by default; `make run` turns it on.
API_DOCS_ENABLED=false
