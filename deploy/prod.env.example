# Names only. Copy the values into ~/.secrets/triagedesk-prod.env (chmod 600), or run deploy/init_secrets.sh once.
# Use it with:  docker compose --env-file ~/.secrets/triagedesk-prod.env -f docker-compose.prod.yml ...  (make prod-up does).
# Letters and digits only for POSTGRES_PASSWORD: it is placed inside a connection URL.
POSTGRES_PASSWORD=
# Supabase user id (JWT sub) of the first admin; the demo admin has the fixed id below (scripts/create_demo_users.py).
BOOTSTRAP_ADMIN_SUB=5d1e0000-0000-4000-8000-000000000001
# Optional: without a key every ticket takes the keyword fallback.
GEMINI_API_KEY=
# Local Supabase stack. SUPABASE_URL is the issuer (the iss claim); the API container fetches keys from the host.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWKS_BASE_URL=http://host.docker.internal:54321
SUPABASE_JWKS_ALLOW_PLAIN_HTTP=true
# Host port for Nginx (bound to 127.0.0.1 only) and the fixed network the Nginx address lives in.
NGINX_PORT=8080
PROD_SUBNET=172.29.77.0/24
NGINX_IP=172.29.77.10
